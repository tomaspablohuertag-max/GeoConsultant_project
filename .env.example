# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps API
# (Distance Matrix + Places). Enable both APIs in Google Cloud Console.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Local: http://localhost:3000
# Azure: https://your-app-name.azurewebsites.net
APP_URL="http://localhost:3000"

# MICROSOFT_CLIENT_ID: Client ID from the Microsoft Entra (Azure AD) app registration for OneDrive access
MICROSOFT_CLIENT_ID=""

# MICROSOFT_CLIENT_SECRET: Client Secret from the Microsoft Entra (Azure AD) app registration
MICROSOFT_CLIENT_SECRET=""
