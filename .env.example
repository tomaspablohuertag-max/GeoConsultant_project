# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps API.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The public URL where the app is hosted (e.g. https://your-app.azurewebsites.net).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-app.azurewebsites.net"

# MICROSOFT_CLIENT_ID: Client ID from Azure App Registration for OneDrive access
MICROSOFT_CLIENT_ID=""

# MICROSOFT_CLIENT_SECRET: Client Secret from Azure App Registration for OneDrive access
MICROSOFT_CLIENT_SECRET=""
